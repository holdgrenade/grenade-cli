{
  "name": "grenade-cli",
  "version": "1.0.8",
  "description": "grenaded: the Grenade daemon for macOS, plus the grenade CLI.",
  "type": "module",
  "bin": {
    "grenade": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "release": "node scripts/release.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@grenade/protocol": "file:../grenade-protocol",
    "bonjour-service": "^1.4.4",
    "commander": "^15.0.0",
    "uqr": "0.1.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "private": true
}
